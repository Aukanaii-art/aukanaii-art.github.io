---
import SeoHead from "../../components/SeoHead.astro";
import { projectsConfig } from "../../config/projects";

export function getStaticPaths() {
  return projectsConfig.projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const canonicalPath = `artes/${project.slug}/`;
const artworkSchema = {
  "@context": "https://schema.org",
  "@type": "VisualArtwork",
  name: project.title,
  creator: {
    "@type": "VisualArtist",
    name: "Aukanaii",
    url: "https://aukanaii-art.github.io/portfolio/",
  },
  image: new URL(project.coverImage, Astro.site).toString(),
  url: new URL(`${basePath}${canonicalPath}`, Astro.site).toString(),
  description: project.description,
  artform: project.technique,
  inLanguage: "pt-BR",
  keywords:
    "arte indigena, ilustracao, muralismo, pintura, animacao, tatuagem, arte contemporanea, povos originarios",
};
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{project.title} | Arte indigena de Aukanaii</title>
    <SeoHead
      title={`${project.title} | Arte indigena de Aukanaii`}
      description={`${project.description} Obra de Aukanaii, artista visual indigena Atikum Uma, com trabalhos em ilustracao, muralismo, pintura, animacao e tatuagem.`}
      path={canonicalPath}
      image={project.coverImage}
    />
    <script type="application/ld+json" set:html={JSON.stringify(artworkSchema)} />
  </head>
  <body>
    <main>
      <a href={basePath}>Aukanaii</a>
      <article>
        <p>Portfolio de arte indigena contemporanea</p>
        <h1>{project.title}</h1>
        <p>{project.description}</p>
        <p>{project.technique}</p>
        <img src={project.coverImage} alt={`Obra ${project.title}, de Aukanaii`} />
        {project.galleryImages.length > 1 && (
          <section aria-label={`Galeria da obra ${project.title}`}>
            <h2>Galeria da obra</h2>
            {project.galleryImages.map((image: string, index: number) => (
              <figure>
                <img
                  src={image}
                  alt={project.galleryTexts?.[index] || `${project.title}, imagem ${index + 1}`}
                  loading="lazy"
                />
                {project.galleryTexts?.[index] && <figcaption>{project.galleryTexts[index]}</figcaption>}
              </figure>
            ))}
          </section>
        )}
      </article>
    </main>
  </body>
</html>

<style>
  body { margin: 0; font-family: Georgia, serif; color: #1d2524; background: #f7f4ec; }
  main { width: min(1080px, calc(100% - 2rem)); margin: 0 auto; padding: 2rem 0 4rem; }
  a { color: #0f5e61; }
  article { max-width: 780px; margin: 3rem auto 0; }
  h1 { font-size: clamp(2.25rem, 5vw, 4.5rem); font-weight: 500; }
  p { font-size: 1.1rem; line-height: 1.65; }
  article > img { display: block; width: 100%; height: auto; margin: 2rem 0; }
  section { margin-top: 4rem; }
  figure { margin: 2rem 0; }
  figure img { display: block; width: 100%; height: auto; }
  figcaption { margin-top: .75rem; }
</style>