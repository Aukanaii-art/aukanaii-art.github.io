---
import "../styles/home.css";
import "../styles/simular-parede.css";
import "../styles/page-transitions.css";
import Footer from "../components/Footer.astro";
import SeoHead from "../components/SeoHead.astro";
import { projectsConfig } from "../config/projects";

const normalizedBaseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href={`${normalizedBaseUrl}image/arteazul_icone.png`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Simular arte na parede | Aukanaii</title>
    <SeoHead
      title="Simular arte na parede | Aukanaii"
      description="Use a camera do seu celular para simular como uma obra de Aukanaii ficaria na sua parede, ajustando posicao, tamanho e rotacao em tempo real."
      path="simular-parede/"
      image="image/sobre_mim.jpg"
    />
    <script>
      if ("scrollRestoration" in history) {
        history.scrollRestoration = "manual";
      }
      window.scrollTo(0, 0);
    </script>
  </head>
  <body>
    <nav>
      <a href="/" class="site-name">Aukanaii</a>
      <ul class="nav-menu">
        <li><a href="/" class="menu-link">Início</a></li>
        <li><a href="/about" class="menu-link">Sobre mim</a></li>
        <li><a href="/posts" class="menu-link">Artes</a></li>
        <li><a href="/simular-parede" class="menu-link active">Simular na parede</a></li>
        <li><a href="/contact" class="menu-link">Contato</a></li>
      </ul>
    </nav>

    <main class="wall-ar-page">
      <div class="wall-ar-container page-content">
        <div class="wall-ar-header">
          <h1>Simule uma arte na sua parede em AR</h1>
          <p>
            Escolha uma obra, toque em "Iniciar AR" e aponte a câmera para a parede. Toque na
            parede para posicionar a arte e use dois dedos para redimensionar e girar.
          </p>
        </div>

        <div class="wall-ar-layout">
          <aside class="art-picker" aria-label="Escolha uma arte">
            <h2>Escolha uma arte</h2>
            <div class="art-picker-grid" id="artPickerGrid">
              {projectsConfig.projects.map((project) => (
                <button
                  type="button"
                  class="art-thumb"
                  data-src={project.coverImage}
                  data-title={project.title}
                >
                  <img src={project.coverImage} alt={project.title} loading="lazy" />
                  <span>{project.title}</span>
                </button>
              ))}
            </div>
          </aside>

          <div class="ar-panel">
            <div class="ar-support-message" id="arUnsupported" hidden>
              <p>
                Seu navegador ou dispositivo não tem suporte a AR (WebXR). Essa funcionalidade
                funciona apenas em navegadores compatíveis, como o Chrome no Android com suporte
                a ARCore.
              </p>
            </div>
            <button type="button" class="ar-btn ar-btn-primary" id="startArBtn" disabled>
              Iniciar AR
            </button>
            <p class="ar-hint" id="arHint">Escolha uma arte ao lado para habilitar o AR.</p>
          </div>
        </div>
      </div>
    </main>

    <!-- WebXR dom-overlay: composited above the camera feed only during the AR session -->
    <div class="ar-overlay-root" id="arOverlay">
      <p class="ar-overlay-hint" id="arOverlayHint">Toque na parede para posicionar a arte.</p>
      <div class="ar-overlay-controls">
        <button type="button" class="ar-btn" id="arRemoveBtn" hidden>Remover</button>
        <button type="button" class="ar-btn" id="arExitBtn">Sair do AR</button>
      </div>
    </div>

    <Footer />

    <script>
      import * as THREE from "three";

      const startArBtn = document.getElementById("startArBtn") as HTMLButtonElement;
      const arUnsupported = document.getElementById("arUnsupported") as HTMLDivElement;
      const arOverlay = document.getElementById("arOverlay") as HTMLDivElement;
      const arOverlayHint = document.getElementById("arOverlayHint") as HTMLParagraphElement;
      const arRemoveBtn = document.getElementById("arRemoveBtn") as HTMLButtonElement;
      const arExitBtn = document.getElementById("arExitBtn") as HTMLButtonElement;
      const arHint = document.getElementById("arHint") as HTMLParagraphElement;

      let selectedSrc: string | null = null;
      let selectedTitle = "";

      document.querySelectorAll<HTMLButtonElement>(".art-thumb").forEach((btn) => {
        btn.addEventListener("click", () => {
          selectedSrc = btn.dataset.src || null;
          selectedTitle = btn.dataset.title || "Arte";
          document.querySelectorAll<HTMLButtonElement>(".art-thumb").forEach((b) => {
            b.classList.toggle("selected", b === btn);
          });
          startArBtn.disabled = false;
          arHint.textContent = `Arte selecionada: ${selectedTitle}. Toque em "Iniciar AR".`;
        });
      });

      if (navigator.xr) {
        navigator.xr
          .isSessionSupported("immersive-ar")
          .then((supported) => {
            if (!supported) {
              arUnsupported.hidden = false;
              startArBtn.hidden = true;
            }
          })
          .catch(() => {
            arUnsupported.hidden = false;
            startArBtn.hidden = true;
          });
      } else {
        arUnsupported.hidden = false;
        startArBtn.hidden = true;
      }

      let renderer: THREE.WebGLRenderer | null = null;
      let scene: THREE.Scene | null = null;
      let camera: THREE.PerspectiveCamera | null = null;
      let reticle: THREE.Mesh | null = null;
      let placedMesh: THREE.Mesh | null = null;
      let hitTestSource: XRHitTestSource | null = null;
      let currentSession: XRSession | null = null;

      function initThree() {
        scene = new THREE.Scene();
        camera = new THREE.PerspectiveCamera(70, window.innerWidth / window.innerHeight, 0.01, 20);

        renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
        renderer.setPixelRatio(window.devicePixelRatio);
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.xr.enabled = true;
        renderer.domElement.style.position = "fixed";
        renderer.domElement.style.inset = "0";
        renderer.domElement.style.zIndex = "40";
        document.body.appendChild(renderer.domElement);

        scene.add(new THREE.HemisphereLight(0xffffff, 0x444444, 1.2));

        const reticleGeometry = new THREE.RingGeometry(0.07, 0.09, 32).rotateX(-Math.PI / 2);
        const reticleMaterial = new THREE.MeshBasicMaterial({ color: 0x7026b9 });
        reticle = new THREE.Mesh(reticleGeometry, reticleMaterial);
        reticle.matrixAutoUpdate = false;
        reticle.visible = false;
        scene.add(reticle);

        window.addEventListener("resize", onWindowResize);
      }

      function onWindowResize() {
        if (!renderer || !camera) return;
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      }

      async function placeArtwork(matrixArray: number[]) {
        if (!selectedSrc || !scene) return;

        const texture = await new THREE.TextureLoader().loadAsync(selectedSrc);
        texture.colorSpace = THREE.SRGBColorSpace;

        const aspect = texture.image.width / texture.image.height;
        const height = 0.6;
        const width = height * aspect;

        if (placedMesh) {
          scene.remove(placedMesh);
          placedMesh.geometry.dispose();
          (placedMesh.material as THREE.Material).dispose();
        }

        const geometry = new THREE.PlaneGeometry(width, height).rotateX(-Math.PI / 2);
        const material = new THREE.MeshBasicMaterial({
          map: texture,
          side: THREE.DoubleSide,
          transparent: true,
        });
        placedMesh = new THREE.Mesh(geometry, material);

        const matrix4 = new THREE.Matrix4().fromArray(matrixArray);
        const position = new THREE.Vector3();
        const quaternion = new THREE.Quaternion();
        const scaleVec = new THREE.Vector3();
        matrix4.decompose(position, quaternion, scaleVec);

        placedMesh.position.copy(position);
        placedMesh.quaternion.copy(quaternion);
        scene.add(placedMesh);

        arRemoveBtn.hidden = false;
        arOverlayHint.textContent =
          'Arte posicionada. Use dois dedos para redimensionar e girar, ou toque novamente para reposicionar.';
      }

      function onSelect() {
        if (reticle && reticle.visible) {
          placeArtwork(Array.from(reticle.matrix.elements));
        }
      }

      function removePlacedArtwork() {
        if (placedMesh && scene) {
          scene.remove(placedMesh);
          placedMesh.geometry.dispose();
          (placedMesh.material as THREE.Material).dispose();
          placedMesh = null;
        }
        arRemoveBtn.hidden = true;
        arOverlayHint.textContent = "Toque na parede para posicionar a arte.";
      }

      arRemoveBtn.addEventListener("click", removePlacedArtwork);

      async function startAR() {
        if (!navigator.xr) return;
        initThree();
        if (!renderer || !scene || !camera) return;

        arOverlay.style.display = "flex";

        try {
          currentSession = await navigator.xr.requestSession("immersive-ar", {
            requiredFeatures: ["hit-test"],
            optionalFeatures: ["dom-overlay"],
            domOverlay: { root: arOverlay },
          } as XRSessionInit);
        } catch (error) {
          arOverlay.style.display = "none";
          cleanupThree();
          arUnsupported.hidden = false;
          arUnsupported.querySelector("p")!.textContent =
            "Não foi possível iniciar a sessão de AR neste dispositivo.";
          return;
        }

        renderer.xr.setReferenceSpaceType("local");
        await renderer.xr.setSession(currentSession);

        const viewerSpace = await currentSession.requestReferenceSpace("viewer");
        hitTestSource = (await currentSession.requestHitTestSource!({ space: viewerSpace })) ?? null;

        const controller = renderer.xr.getController(0);
        controller.addEventListener("select", onSelect);
        scene.add(controller);

        currentSession.addEventListener("end", onSessionEnd);

        renderer.setAnimationLoop((_timestamp, frame) => {
          if (frame && renderer && reticle) {
            const refSpace = renderer.xr.getReferenceSpace();
            if (hitTestSource && refSpace) {
              const hitTestResults = frame.getHitTestResults(hitTestSource);
              if (hitTestResults.length > 0) {
                const pose = hitTestResults[0].getPose(refSpace);
                if (pose) {
                  reticle.visible = true;
                  reticle.matrix.fromArray(pose.transform.matrix);
                }
              } else {
                reticle.visible = false;
              }
            }
          }
          if (renderer && scene && camera) {
            renderer.render(scene, camera);
          }
        });

        setupGestures();
      }

      function onSessionEnd() {
        renderer?.setAnimationLoop(null);
        if (hitTestSource) {
          hitTestSource.cancel();
          hitTestSource = null;
        }
        arOverlay.style.display = "none";
        cleanupThree();
        teardownGestures();
      }

      function cleanupThree() {
        renderer?.domElement.remove();
        renderer?.dispose();
        renderer = null;
        scene = null;
        camera = null;
        reticle = null;
        placedMesh = null;
        currentSession = null;
        arRemoveBtn.hidden = true;
      }

      startArBtn.addEventListener("click", startAR);
      arExitBtn.addEventListener("click", () => {
        currentSession?.end();
      });

      // --- Pinch-to-scale and twist-to-rotate gestures on the dom-overlay layer ---

      let gestureState: {
        distance: number;
        angle: number;
        scale: number;
        rotationY: number;
      } | null = null;

      function getTouchDistance(touches: TouchList) {
        return Math.hypot(
          touches[0].clientX - touches[1].clientX,
          touches[0].clientY - touches[1].clientY
        );
      }

      function getTouchAngle(touches: TouchList) {
        return Math.atan2(
          touches[1].clientY - touches[0].clientY,
          touches[1].clientX - touches[0].clientX
        );
      }

      function onTouchStart(event: TouchEvent) {
        if (event.touches.length === 2 && placedMesh) {
          gestureState = {
            distance: getTouchDistance(event.touches),
            angle: getTouchAngle(event.touches),
            scale: placedMesh.scale.x,
            rotationY: placedMesh.rotation.y,
          };
        }
      }

      function onTouchMove(event: TouchEvent) {
        if (!gestureState || event.touches.length !== 2 || !placedMesh) return;
        event.preventDefault();
        const distance = getTouchDistance(event.touches);
        const angle = getTouchAngle(event.touches);
        const scaleFactor = distance / gestureState.distance;
        const newScale = Math.min(Math.max(gestureState.scale * scaleFactor, 0.2), 4);
        placedMesh.scale.set(newScale, newScale, newScale);
        placedMesh.rotation.y = gestureState.rotationY + (angle - gestureState.angle);
      }

      function onTouchEnd(event: TouchEvent) {
        if (event.touches.length < 2) {
          gestureState = null;
        }
      }

      function setupGestures() {
        arOverlay.addEventListener("touchstart", onTouchStart, { passive: false });
        arOverlay.addEventListener("touchmove", onTouchMove, { passive: false });
        arOverlay.addEventListener("touchend", onTouchEnd);
      }

      function teardownGestures() {
        arOverlay.removeEventListener("touchstart", onTouchStart);
        arOverlay.removeEventListener("touchmove", onTouchMove);
        arOverlay.removeEventListener("touchend", onTouchEnd);
        gestureState = null;
      }

      document.addEventListener("DOMContentLoaded", () => {
        const pageContent = document.querySelector(".page-content");
        if (pageContent) {
          requestAnimationFrame(() => {
            pageContent.classList.add("visible");
          });
        }
      });
    </script>
  </body>
</html>
