---
import "../styles/home.css";
import "../styles/page-transitions.css";
import Navigation from "../components/Navigation.astro";
import HeroSection from "../components/HeroSection.astro";
import AboutSection from "../components/AboutSection.astro";
import ProficiencySection from "../components/ProficiencySection.astro";
import ProjectsSection from "../components/ProjectsSection.astro";
import ContactSection from "../components/ContactSection.astro";
import Footer from "../components/Footer.astro";
import SeoHead from "../components/SeoHead.astro";

const normalizedBaseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const pressArticleSchema = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "@id": "https://novaimprensa.com/2026/08/por-ai-artista-resgata-ancestralidade-indigena-no-litoral-norte.html#article",
  headline: "Por aí: Artista resgata ancestralidade indígena no Litoral Norte",
  description:
    "Reportagem sobre a trajetória de Aukanaii, artista visual indígena Atikum-Umã e Pankará, e seu trabalho de resgate da ancestralidade no Litoral Norte.",
  datePublished: "2026-08-27",
  inLanguage: "pt-BR",
  author: {
    "@type": "Person",
    name: "Fernanda Veiga",
  },
  publisher: {
    "@type": "NewsMediaOrganization",
    name: "Nova Imprensa",
    url: "https://novaimprensa.com/",
  },
  about: {
    "@id": "https://aukanaii-art.github.io/#artist",
  },
  mainEntityOfPage:
    "https://novaimprensa.com/2026/08/por-ai-artista-resgata-ancestralidade-indigena-no-litoral-norte.html",
  associatedMedia: {
    "@type": "MediaObject",
    contentUrl: `${normalizedBaseUrl}images/posts/nova_imprensa/noticia.pdf`,
    encodingFormat: "application/pdf",
    name: "Cópia arquivada da reportagem do Nova Imprensa",
  },
};
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href={`${normalizedBaseUrl}image/arteazul_icone.png`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Aukanaii | Artista visual indigena Atikum Uma</title>
    <SeoHead
      title="Aukanaii | Artista visual indigena Atikum Uma"
      description="Portfolio de Aukanaii, artista visual indigena Atikum Uma. Conheca ilustracoes, pinturas, murais, animacoes e tatuagens autorais sobre ancestralidade, territorio, memoria e povos originarios."
      image="image/sobre_mim.jpg"
    />
    <script type="application/ld+json" set:html={JSON.stringify(pressArticleSchema)} />
    <script>
      // Disable browser scroll restoration and ensure page starts at top
      if ("scrollRestoration" in history) {
        history.scrollRestoration = "manual";
      }
      // Immediately scroll to top on page load
      window.scrollTo(0, 0);
    </script>
  </head>
  <body>
    <Navigation />
    <HeroSection />
    <AboutSection />
    <ProjectsSection />
    <ContactSection />
    <ProficiencySection />
    <Footer />
    <script>
      // Ensure scroll position is at top after DOM loads
      document.addEventListener("DOMContentLoaded", () => {
        window.scrollTo(0, 0);
        // Also ensure after a short delay to handle any layout shifts
        setTimeout(() => {
          window.scrollTo(0, 0);
        }, 0);
      });
      // Also ensure on page show (handles back/forward navigation)
      window.addEventListener("pageshow", (event) => {
        if (event.persisted) {
          window.scrollTo(0, 0);
        }
      });
    </script>
  </body>
</html>
